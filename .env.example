# Copy to .env.local (local) or set these in your host's env panel (deploy).
# cp .env.example .env.local

# Leave empty — auth/orders/menu APIs are Next.js routes on this app (/api/*).
# NEXT_PUBLIC_API_URL=

# MongoDB Atlas (use database name restaurantos)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/restaurantos?retryWrites=true&w=majority

# Auth JWT signing secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# QR ordering HMAC master key — different from JWT_SECRET
QR_MASTER_KEY=change-me-to-another-long-random-secret

# Public app URL (no trailing slash). Local: http://localhost:3000
APP_URL=https://your-production-domain.com

# Socket.IO realtime (KDS/order live updates). Requires `npm run start:socket` / VM —
# NOT supported on Vercel serverless. Leave unset on Vercel (client auto-skips).
# Localhost enables automatically. Set to 1 on a Node host that runs server.mjs.
# NEXT_PUBLIC_ENABLE_SOCKETIO=1

# --- Restaurant AI Copilot ---
# Prefer NVIDIA NIM (OpenAI-compatible) when NVIDIA_API_KEY is set.
# Get a key from https://build.nvidia.com/ (NGC Docker registry keys may not work for chat).
NVIDIA_API_KEY=
# NGC_API_KEY=   # alias accepted
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
# NVIDIA_BASE_URL is the OpenAI-compatible root (…/v1), not …/chat/completions

# Fallback: OpenAI (used only if NVIDIA_* key is unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# After deploy: open /ai → Knowledge → Reindex from DB (OWNER/MANAGER).

# --- Razorpay subscriptions (INR) ---
# Create plans in Razorpay Dashboard → Subscriptions → Plans, then paste plan_ids.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_ENTERPRISE=
# Webhook URL: {APP_URL}/api/billing/webhook
# Events: subscription.activated, subscription.charged, subscription.pending,
#         subscription.halted, subscription.cancelled, subscription.completed
