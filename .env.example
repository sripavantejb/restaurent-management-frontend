# Copy to .env.local (local) or set these in your host's env panel (deploy).
# cp .env.example .env.local

# Leave empty — auth/orders/menu APIs are Next.js routes on this app (/api/*).
# NEXT_PUBLIC_API_URL=

# MongoDB Atlas (use database name restaurantos)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/restaurantos?retryWrites=true&w=majority

# Auth JWT signing secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# QR ordering HMAC master key — different from JWT_SECRET
QR_MASTER_KEY=change-me-to-another-long-random-secret

# Public app URL (no trailing slash). Local: http://localhost:3000
APP_URL=https://your-production-domain.com

# --- Restaurant AI Copilot ---
# Optional: without a key, Copilot runs deterministic tool routing (still live data).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Razorpay subscriptions (INR) ---
# Create plans in Razorpay Dashboard → Subscriptions → Plans, then paste plan_ids.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_ENTERPRISE=
# Webhook URL: {APP_URL}/api/billing/webhook
# Events: subscription.activated, subscription.charged, subscription.pending,
#         subscription.halted, subscription.cancelled, subscription.completed
